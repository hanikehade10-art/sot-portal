{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Student, Course Rep, or Admin user profile",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]{1,128}$"
        },
        "email": {
          "type": "string",
          "maxLength": 128
        },
        "fullName": {
          "type": "string",
          "maxLength": 128
        },
        "role": {
          "type": "string",
          "enum": ["student", "rep", "admin"]
        },
        "department": {
          "type": "string",
          "maxLength": 64
        },
        "matricNumber": {
          "type": "string",
          "maxLength": 32
        },
        "idType": {
          "type": "string",
          "enum": ["matric", "jamb"]
        },
        "jambNumber": {
          "type": "string",
          "maxLength": 32
        },
        "profileComplete": {
          "type": "boolean"
        },
        "disabled": {
          "type": "boolean"
        },
        "lastSeenAnnouncements": {
          "type": "string",
          "format": "date-time"
        },
        "completedTopics": {
          "type": "array"
        },
        "lastTopic": {
          "type": "object"
        },
        "accessibilitySettings": {
          "type": "object"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "email", "profileComplete", "role"]
    },
    "CourseItem": {
      "title": "CourseItem",
      "description": "Department syllabus courses categorized by academic level and semester",
      "type": "object",
      "properties": {
        "department": { "type": "string", "maxLength": 64 },
        "code": { "type": "string", "maxLength": 32 },
        "title": { "type": "string", "maxLength": 200 },
        "level": { "type": "string", "enum": ["ND I", "ND II", "HND I", "HND II"] },
        "semester": { "type": "string", "enum": ["1st Semester", "2nd Semester"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["department", "code", "title", "level", "semester"]
    },
    "TopicItem": {
      "title": "TopicItem",
      "description": "Syllabus topic belonging to a course, ordered sequentially with lesson content",
      "type": "object",
      "properties": {
        "courseId": { "type": "string", "maxLength": 128 },
        "department": { "type": "string", "maxLength": 64 },
        "level": { "type": "string" },
        "semester": { "type": "string" },
        "title": { "type": "string", "maxLength": 300 },
        "order": { "type": "number" },
        "estimatedMinutes": { "type": "number" },
        "videoUrl": { "type": "string" },
        "videoAccessibleText": { "type": "string" },
        "notes": { "type": "string" },
        "notesPdfUrl": { "type": "string" },
        "notesAccessibleText": { "type": "string" },
        "summary": { "type": "string" },
        "furtherReading": { "type": "array" },
        "linkedQuizId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["courseId", "department", "level", "semester", "title", "order"]
    },
    "TimetableEntry": {
      "title": "TimetableEntry",
      "description": "Department weekly class schedule or examination timetable",
      "type": "object",
      "properties": {
        "department": { "type": "string", "maxLength": 64 },
        "level": { "type": "string", "enum": ["ND I", "ND II", "HND I", "HND II"] },
        "day": { "type": "string", "enum": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"] },
        "startTime": { "type": "string", "maxLength": 32 },
        "endTime": { "type": "string", "maxLength": 32 },
        "courseCode": { "type": "string", "maxLength": 64 },
        "venue": { "type": "string", "maxLength": 128 },
        "type": { "type": "string", "enum": ["class", "exam"] },
        "date": { "type": "string", "maxLength": 32 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["department", "level", "day", "startTime", "endTime", "courseCode", "venue", "type"]
    },
    "AdminDoc": {
      "title": "AdminDoc",
      "description": "Admin authorization entry",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "grantedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email"]
    },
    "MatricRegistry": {
      "title": "MatricRegistry",
      "description": "Uniqueness reservation index mapping matricNumber uppercase to user UID",
      "type": "object",
      "properties": {
        "matricNumber": { "type": "string", "maxLength": 32 },
        "uid": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["matricNumber", "uid"]
    },
    "ContactMessage": {
      "title": "ContactMessage",
      "description": "Contact form submissions including complaints, reviews, and enquiries with admin tracking & reply",
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 128 },
        "type": { "type": "string", "enum": ["Complaint", "Review", "Enquiry"] },
        "message": { "type": "string", "maxLength": 3000 },
        "status": { "type": "string", "enum": ["New", "Read", "Resolved"] },
        "userId": { "type": "string" },
        "uid": { "type": "string" },
        "adminReply": { "type": "string", "maxLength": 3000 },
        "repliedAt": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "email", "type", "message", "status"]
    },
    "Announcement": {
      "title": "Announcement",
      "description": "Faculty announcements created by admins or department course reps",
      "type": "object",
      "properties": {
        "title": { "type": "string", "maxLength": 200 },
        "content": { "type": "string", "maxLength": 5000 },
        "category": { "type": "string" },
        "department": { "type": "string" },
        "urgent": { "type": "boolean" },
        "author": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "content", "department", "createdAt"]
    },
    "FaqItem": {
      "title": "FaqItem",
      "description": "Knowledge base Q&A for the SOT Assistant chatbot and FAQ pages",
      "type": "object",
      "properties": {
        "question": { "type": "string", "maxLength": 500 },
        "answer": { "type": "string", "maxLength": 3000 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["question", "answer"]
    },
    "CourseSheet": {
      "title": "CourseSheet",
      "description": "Department course curriculum PDF sheet for a specific academic level and semester",
      "type": "object",
      "properties": {
        "department": { "type": "string", "maxLength": 64 },
        "level": { "type": "string", "enum": ["ND1", "ND2", "HND1", "HND2"] },
        "semester": { "type": "string", "enum": ["First", "Second"] },
        "title": { "type": "string", "maxLength": 255 },
        "url": { "type": "string", "maxLength": 2048 },
        "fileName": { "type": "string", "maxLength": 255 },
        "uploadedBy": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["department", "level", "semester", "title", "url", "fileName", "uploadedBy", "createdAt"]
    },
    "QuizItem": {
      "title": "QuizItem",
      "description": "Department academic multiple choice quiz with questions and options (no correct answers)",
      "type": "object",
      "properties": {
        "department": { "type": "string", "maxLength": 64 },
        "level": { "type": "string", "maxLength": 32 },
        "semester": { "type": "string", "maxLength": 32 },
        "courseCode": { "type": "string", "maxLength": 32 },
        "topicId": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 200 },
        "instructions": { "type": "string", "maxLength": 2000 },
        "timeLimit": { "type": "number" },
        "passingScore": { "type": "number" },
        "attemptsAllowed": { "type": "number" },
        "pointsPerQuestion": { "type": "number" },
        "allowPartialCredit": { "type": "boolean" },
        "shuffle": { "type": "boolean" },
        "published": { "type": "boolean" },
        "questionCount": { "type": "number" },
        "createdBy": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["department", "level", "semester", "courseCode", "title", "published", "questionCount", "createdBy", "createdAt"]
    },
    "QuizKeyDoc": {
      "title": "QuizKeyDoc",
      "description": "Answer keys and explanations for a quiz (separated from public quiz document to prevent student cheating)",
      "type": "object",
      "properties": {
        "quizId": { "type": "string", "maxLength": 128 },
        "department": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["quizId", "department"]
    },
    "QuizAttemptDoc": {
      "title": "QuizAttemptDoc",
      "description": "Student quiz attempt records, scores, and submitted answer choices",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "quizId": { "type": "string", "maxLength": 128 },
        "department": { "type": "string", "maxLength": 64 },
        "studentName": { "type": "string", "maxLength": 128 },
        "matricNumber": { "type": "string", "maxLength": 64 },
        "score": { "type": "number" },
        "total": { "type": "number" },
        "attempts": { "type": "number" },
        "bestScore": { "type": "number" },
        "aiExplanations": { "type": "object", "description": "Cached AI generated explanations keyed by questionId" },
        "submittedAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "quizId", "department", "score", "total", "attempts", "bestScore", "submittedAt"]
    },
    "ActivityLog": {
      "title": "ActivityLog",
      "description": "Admin or Rep activity log for tracking modifications to course content, quizzes, and resources",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 128 },
        "role": { "type": "string", "maxLength": 64 },
        "action": { "type": "string", "enum": ["Created", "Updated", "Deleted"] },
        "itemType": { "type": "string" },
        "title": { "type": "string", "maxLength": 200 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "role", "action", "itemType", "title", "createdAt"]
    },
    "StudentActivity": {
      "title": "StudentActivity",
      "description": "Student telemetry events such as login, logout, topic completed, or quiz submitted",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 128 },
        "department": { "type": "string", "maxLength": 64 },
        "level": { "type": "string", "maxLength": 32 },
        "type": { "type": "string" },
        "title": { "type": "string", "maxLength": 200 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "type", "title", "createdAt"]
    },
    "MockExamAttempt": {
      "title": "MockExamAttempt",
      "description": "Student Mock CBT exam session result and review record",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "department": { "type": "string", "maxLength": 64 },
        "courseId": { "type": "string", "maxLength": 128 },
        "courseCode": { "type": "string", "maxLength": 32 },
        "courseTitle": { "type": "string", "maxLength": 200 },
        "totalQuestions": { "type": "number" },
        "answeredCount": { "type": "number" },
        "correctCount": { "type": "number" },
        "score": { "type": "number" },
        "percentage": { "type": "number" },
        "timeLimitMinutes": { "type": "number" },
        "timeUsedSeconds": { "type": "number" },
        "passed": { "type": "boolean" },
        "questionsReview": { "type": "array" },
        "submittedAt": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "department", "courseCode", "totalQuestions", "score", "percentage", "submittedAt"]
    },
    "WeeklyLeaderboardEntry": {
      "title": "WeeklyLeaderboardEntry",
      "description": "Weekly department quiz points leaderboard entry for opted-in students",
      "type": "object",
      "properties": {
        "weekId": { "type": "string", "maxLength": 32 },
        "uid": { "type": "string", "maxLength": 128 },
        "department": { "type": "string", "maxLength": 64 },
        "firstName": { "type": "string", "maxLength": 64 },
        "points": { "type": "number" },
        "quizzesCompleted": { "type": "number" },
        "optIn": { "type": "boolean" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["weekId", "uid", "department", "firstName", "points", "optIn"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profiles. Students read/write own; Admins read/manage all"
    },
    "/admins/{adminId}": {
      "schema": "AdminDoc",
      "description": "Admin authorization documents"
    },
    "/matricNumbers/{matricId}": {
      "schema": "MatricRegistry",
      "description": "Active matriculation number reservation documents"
    },
    "/matric_registry/{matricId}": {
      "schema": "MatricRegistry",
      "description": "Legacy matric number uniqueness mapping"
    },
    "/courses/{courseId}": {
      "schema": "CourseItem",
      "description": "Department syllabus courses. Read by all students; Managed by admins"
    },
    "/topics/{topicId}": {
      "schema": "TopicItem",
      "description": "Topics belonging to courses with structured video and notes"
    },
    "/timetables/{timetableId}": {
      "schema": "TimetableEntry",
      "description": "Department class and exam timetables. Read by students; Managed by admins"
    },
    "/messages/{messageId}": {
      "schema": "ContactMessage",
      "description": "Contact enquiries, complaints, and reviews with student tracking & admin replies"
    },
    "/announcements/{announcementId}": {
      "schema": "Announcement",
      "description": "Department and general announcements posted by admins and department reps"
    },
    "/faqs/{faqId}": {
      "schema": "FaqItem",
      "description": "Frequently asked questions for chatbot knowledge and student queries"
    },
    "/courseSheets/{id}": {
      "schema": "CourseSheet",
      "description": "Official course sheet PDFs per department, level, and semester. Read by students; Managed by admins"
    },
    "/quizzes/{quizId}": {
      "schema": "QuizItem",
      "description": "Department multiple choice quizzes. Read by students; Managed by admins and department reps"
    },
    "/quizKeys/{quizId}": {
      "schema": "QuizKeyDoc",
      "description": "Answer keys and explanations for quizzes. Read by admins, reps, or students after submitting; Managed by admins and reps"
    },
    "/quizAttempts/{attemptId}": {
      "schema": "QuizAttemptDoc",
      "description": "Student quiz attempts and scores. Read by owner, admin, or rep; Created/updated by student"
    },
    "/activityLogs/{logId}": {
      "schema": "ActivityLog",
      "description": "Administrative and representative modification logs. Read by admins; Created by admins/reps"
    },
    "/studentActivity/{id}": {
      "schema": "StudentActivity",
      "description": "Student engagement and event telemetry logs. Read by admins; Created by signed-in students"
    },
    "/mockExamAttempts/{attemptId}": {
      "schema": "MockExamAttempt",
      "description": "Student Mock CBT exam attempts, scores, and question review data. Read/created by the student"
    },
    "/weeklyLeaderboard/{docId}": {
      "schema": "WeeklyLeaderboardEntry",
      "description": "Weekly department quiz points leaderboard. Read by students; Created/updated by the student owner"
    }
  }
}
