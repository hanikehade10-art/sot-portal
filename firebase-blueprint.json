{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Student, Course Rep, or Admin user profile",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]{1,128}$"
        },
        "email": {
          "type": "string",
          "maxLength": 128
        },
        "fullName": {
          "type": "string",
          "maxLength": 128
        },
        "role": {
          "type": "string",
          "enum": ["student", "rep", "admin"]
        },
        "department": {
          "type": "string",
          "maxLength": 64
        },
        "matricNumber": {
          "type": "string",
          "maxLength": 32
        },
        "profileComplete": {
          "type": "boolean"
        },
        "disabled": {
          "type": "boolean"
        },
        "lastSeenAnnouncements": {
          "type": "string",
          "format": "date-time"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "email", "profileComplete", "role"]
    },
    "CourseItem": {
      "title": "CourseItem",
      "description": "Department syllabus courses categorized by academic level and semester",
      "type": "object",
      "properties": {
        "department": { "type": "string", "maxLength": 64 },
        "code": { "type": "string", "maxLength": 32 },
        "title": { "type": "string", "maxLength": 200 },
        "level": { "type": "string", "enum": ["ND I", "ND II", "HND I", "HND II"] },
        "semester": { "type": "string", "enum": ["1st Semester", "2nd Semester"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["department", "code", "title", "level", "semester"]
    },
    "TimetableEntry": {
      "title": "TimetableEntry",
      "description": "Department weekly class schedule or examination timetable",
      "type": "object",
      "properties": {
        "department": { "type": "string", "maxLength": 64 },
        "level": { "type": "string", "enum": ["ND I", "ND II", "HND I", "HND II"] },
        "day": { "type": "string", "enum": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"] },
        "startTime": { "type": "string", "maxLength": 32 },
        "endTime": { "type": "string", "maxLength": 32 },
        "courseCode": { "type": "string", "maxLength": 64 },
        "venue": { "type": "string", "maxLength": 128 },
        "type": { "type": "string", "enum": ["class", "exam"] },
        "date": { "type": "string", "maxLength": 32 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["department", "level", "day", "startTime", "endTime", "courseCode", "venue", "type"]
    },
    "AdminDoc": {
      "title": "AdminDoc",
      "description": "Admin authorization entry",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "grantedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email"]
    },
    "MatricRegistry": {
      "title": "MatricRegistry",
      "description": "Uniqueness reservation index mapping matricNumber uppercase to user UID",
      "type": "object",
      "properties": {
        "matricNumber": { "type": "string", "maxLength": 32 },
        "uid": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["matricNumber", "uid"]
    },
    "ContactMessage": {
      "title": "ContactMessage",
      "description": "Contact form submissions including complaints, reviews, and enquiries with admin tracking & reply",
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 128 },
        "type": { "type": "string", "enum": ["Complaint", "Review", "Enquiry"] },
        "message": { "type": "string", "maxLength": 3000 },
        "status": { "type": "string", "enum": ["New", "Read", "Resolved"] },
        "userId": { "type": "string" },
        "uid": { "type": "string" },
        "adminReply": { "type": "string", "maxLength": 3000 },
        "repliedAt": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "email", "type", "message", "status"]
    },
    "Announcement": {
      "title": "Announcement",
      "description": "Faculty announcements created by admins or department course reps",
      "type": "object",
      "properties": {
        "title": { "type": "string", "maxLength": 200 },
        "content": { "type": "string", "maxLength": 5000 },
        "category": { "type": "string" },
        "department": { "type": "string" },
        "urgent": { "type": "boolean" },
        "author": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "content", "department", "createdAt"]
    },
    "FaqItem": {
      "title": "FaqItem",
      "description": "Knowledge base Q&A for the SOT Assistant chatbot and FAQ pages",
      "type": "object",
      "properties": {
        "question": { "type": "string", "maxLength": 500 },
        "answer": { "type": "string", "maxLength": 3000 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["question", "answer"]
    },
    "CourseSheet": {
      "title": "CourseSheet",
      "description": "Department course curriculum PDF sheet for a specific academic level and semester",
      "type": "object",
      "properties": {
        "department": { "type": "string", "maxLength": 64 },
        "level": { "type": "string", "enum": ["ND1", "ND2", "HND1", "HND2"] },
        "semester": { "type": "string", "enum": ["First", "Second"] },
        "title": { "type": "string", "maxLength": 255 },
        "url": { "type": "string", "maxLength": 2048 },
        "fileName": { "type": "string", "maxLength": 255 },
        "uploadedBy": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["department", "level", "semester", "title", "url", "fileName", "uploadedBy", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profiles. Students read/write own; Admins read/manage all"
    },
    "/admins/{adminId}": {
      "schema": "AdminDoc",
      "description": "Admin authorization documents"
    },
    "/matricNumbers/{matricId}": {
      "schema": "MatricRegistry",
      "description": "Active matriculation number reservation documents"
    },
    "/matric_registry/{matricId}": {
      "schema": "MatricRegistry",
      "description": "Legacy matric number uniqueness mapping"
    },
    "/courses/{courseId}": {
      "schema": "CourseItem",
      "description": "Department syllabus courses. Read by all students; Managed by admins"
    },
    "/timetables/{timetableId}": {
      "schema": "TimetableEntry",
      "description": "Department class and exam timetables. Read by students; Managed by admins"
    },
    "/messages/{messageId}": {
      "schema": "ContactMessage",
      "description": "Contact enquiries, complaints, and reviews with student tracking & admin replies"
    },
    "/announcements/{announcementId}": {
      "schema": "Announcement",
      "description": "Department and general announcements posted by admins and department reps"
    },
    "/faqs/{faqId}": {
      "schema": "FaqItem",
      "description": "Frequently asked questions for chatbot knowledge and student queries"
    },
    "/courseSheets/{id}": {
      "schema": "CourseSheet",
      "description": "Official course sheet PDFs per department, level, and semester. Read by students; Managed by admins"
    }
  }
}
