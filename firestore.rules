rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function myDept() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.department;
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (request.auth.token.email != null && (
          request.auth.token.email == 'kemibuhari8@gmail.com' ||
          request.auth.token.email.matches('(?i)^kemibuhari8@gmail\\.com$')
        )) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
          (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role is string &&
           get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role.matches('(?i)^\\s*admin\\s*$')) ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'Admin', 'ADMIN', ' admin', 'admin '] ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true
        ))
      );
    }

    function isRep() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
          (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role is string &&
           get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role.matches('(?i)^\\s*rep\\s*$')) ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['rep', 'Rep', 'REP', ' rep', 'rep ']
        );
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidMatricId(id) {
      return id is string && id.size() >= 3 && id.size() <= 64 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // User Profiles Collection
    match /users/{userId} {
      // Authenticated users can get their own user doc without restriction, check profiles, or admin can read/list all
      allow get: if (isSignedIn() && (request.auth.uid == userId || isValidId(userId))) || isAdmin();
      allow list: if isAdmin(); // Only admins can list users for the admin table

      // Create profile: own UID, defaults role to student unless admin
      allow create: if (isOwner(userId) && isValidId(userId) &&
                       incoming().uid == request.auth.uid &&
                       incoming().email is string &&
                       incoming().profileComplete is bool &&
                       (incoming().role == 'student' || isAdmin())) || isAdmin();

      // Update profile:
      // Students/reps can update their own details (name, department, matric, lastSeenAnnouncements)
      // but cannot elevate their own role to admin or rep!
      // Admins can update any profile (e.g. promote to rep, disable, delete)
      allow update: if (
        (isOwner(userId) && isValidId(userId) && incoming().uid == existing().uid && (incoming().role == existing().role || isAdmin())) ||
        isAdmin()
      );

      // Delete: only admins can delete an account
      allow delete: if isAdmin();
    }

    // Admins Collection
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Matric & JAMB Number Collections (For Uniqueness & Reservations)
    match /matricNumbers/{matricId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
      allow create: if isSignedIn() &&
                       (incoming().uid == request.auth.uid || incoming().userId == request.auth.uid || isAdmin());
      allow update: if isSignedIn() &&
                       ((existing().uid == request.auth.uid || existing().userId == request.auth.uid) ||
                        isAdmin() ||
                        (existing().uid != null && !exists(/databases/$(database)/documents/users/$(existing().uid))) ||
                        (existing().userId != null && !exists(/databases/$(database)/documents/users/$(existing().userId))));
      allow delete: if isAdmin() ||
                       (isSignedIn() && matricId.matches('^JAMB_.*') && (existing().uid == request.auth.uid || existing().userId == request.auth.uid)) ||
                       (isSignedIn() &&
                        ((existing().uid != null && !exists(/databases/$(database)/documents/users/$(existing().uid))) ||
                         (existing().userId != null && !exists(/databases/$(database)/documents/users/$(existing().userId)))));
    }

    match /matric_registry/{matricId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
      allow create, update: if isSignedIn() &&
                       ((incoming().uid == request.auth.uid || incoming().userId == request.auth.uid) ||
                        isAdmin() ||
                        (existing().uid != null && !exists(/databases/$(database)/documents/users/$(existing().uid))) ||
                        (existing().userId != null && !exists(/databases/$(database)/documents/users/$(existing().userId))));
      allow delete: if isAdmin() ||
                       (isSignedIn() && matricId.matches('^JAMB_.*') && (existing().uid == request.auth.uid || existing().userId == request.auth.uid)) ||
                       (isSignedIn() &&
                        ((existing().uid != null && !exists(/databases/$(database)/documents/users/$(existing().uid))) ||
                         (existing().userId != null && !exists(/databases/$(database)/documents/users/$(existing().userId)))));
    }

    // Department Courses Collection
    match /courses/{courseId} {
      // Courses are visible to all students and visitors
      allow read, list: if true;
      // Only admins can create, edit, or delete courses
      allow create, update, delete: if isAdmin();
    }

    // Topics Collection (Syllabus topics and interactive lessons)
    match /topics/{id} {
      allow read, list: if isSignedIn();
      allow create: if isAdmin() || (
        isRep() &&
        incoming().department == myDept()
      );
      allow update, delete: if isAdmin() || (
        isRep() &&
        resource.data.department == myDept()
      );
    }

    // Timetables Collection (Class schedules & Exam timetables)
    match /timetables/{timetableId} {
      // Any signed in student can read timetables
      allow read, list: if isSignedIn();
      // Only admins can create, edit, or delete timetable entries
      allow create, update, delete: if isAdmin();
    }

    // Contact Messages (Complaints, Reviews, Enquiries with tracking & replies)
    match /messages/{messageId} {
      // Anyone logged in or guest submitting from contact page can create
      allow create: if isValidId(messageId) &&
                       incoming().name is string && incoming().name.size() <= 128 &&
                       incoming().email is string && incoming().email.size() <= 128 &&
                       incoming().type in ['Complaint', 'Review', 'Enquiry'] &&
                       incoming().status in ['New', 'Read', 'Resolved'];

      // Admins can read all; Students can read their own submitted messages
      allow get: if isAdmin() || (
        isSignedIn() && (
          (resource.data.userId != null && resource.data.userId == request.auth.uid) ||
          (resource.data.uid != null && resource.data.uid == request.auth.uid)
        )
      );

      allow list: if isAdmin() || (
        isSignedIn() && (
          (resource.data.userId != null && resource.data.userId == request.auth.uid) ||
          (resource.data.uid != null && resource.data.uid == request.auth.uid)
        )
      );

      // Only admins can update status, provide admin replies, or delete messages
      allow update, delete: if isAdmin();
    }

    // Announcements
    match /announcements/{announcementId} {
      // Anyone signed in can read announcements
      allow read, list: if isSignedIn();

      // Admins can create any announcement.
      // Course Reps can create announcements ONLY for their own department!
      allow create: if isAdmin() || (
        isRep() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        incoming().department == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.department
      );

      // Only admins can edit or delete announcements
      allow update, delete: if isAdmin();
    }

    // FAQs (Chatbot Knowledge Base & Public FAQs)
    match /faqs/{faqId} {
      // Public / all students can read FAQs to empower the chatbot and FAQ views
      allow read, list: if true;
      // Only admins can create, edit, or delete FAQs
      allow create, update, delete: if isAdmin();
    }

    // Uploaded Materials (Resources)
    match /resources/{id} {
      allow read: if signedIn();
      allow create: if isAdmin() || (isRep()
        && request.resource.data.department == myDept()
        && request.resource.data.uploadedBy == request.auth.uid);
      allow update, delete: if isAdmin() || (isRep()
        && resource.data.uploadedBy == request.auth.uid);
    }

    // Site Settings (WhatsApp Channel Link, etc.)
    match /settings/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Communities & Links (WhatsApp groups, departmental portals, associations)
    match /links/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Course PDFs / Curriculum Sheets
    match /courseSheets/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Multiple Choice Quizzes (Questions with options only, NO correct answers)
    match /quizzes/{quizId} {
      allow read, list: if isSignedIn();
      allow create: if isAdmin() || (
        isRep() &&
        incoming().department == myDept() &&
        incoming().createdBy == request.auth.uid
      );
      allow update, delete: if isAdmin() || (
        isRep() &&
        (resource.data.department == myDept() || resource.data.createdBy == request.auth.uid)
      );
    }

    // Quiz Answer Keys & Explanations (Separated so students cannot cheat)
    match /quizKeys/{quizId} {
      allow get: if isAdmin() ||
                    (isRep() && resource.data.department == myDept()) ||
                    (isSignedIn() && exists(/databases/$(database)/documents/quizAttempts/$(request.auth.uid + '_' + quizId)));
      allow list: if isAdmin() || isRep();
      allow create: if isAdmin() || (isRep() && incoming().department == myDept());
      allow update: if isAdmin() || (isRep() && (incoming().department == myDept() || resource.data.department == myDept()));
      allow delete: if isAdmin() || (isRep() && resource.data.department == myDept());
    }

    // Quiz Student Attempts & Results
    match /quizAttempts/{attemptId} {
      allow get: if isSignedIn() && (
        resource.data.uid == request.auth.uid ||
        isAdmin() ||
        (isRep() && resource.data.department == myDept())
      );
      allow list: if isSignedIn() && (
        isAdmin() ||
        isRep() ||
        resource.data.uid == request.auth.uid
      );
      allow create: if isSignedIn() &&
                       incoming().uid == request.auth.uid &&
                       attemptId == (request.auth.uid + '_' + incoming().quizId);
      allow update: if isSignedIn() &&
                       ((existing().uid == request.auth.uid && incoming().uid == request.auth.uid) || isAdmin());
      allow delete: if isAdmin();
    }

    // Admin & Rep Activity Logs
    match /activityLogs/{logId} {
      allow create: if (isAdmin() || isRep()) && incoming().uid == request.auth.uid;
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    // Student Activity Logs (Strictly limited event tracking)
    match /studentActivity/{id} {
      allow create: if isSignedIn() && incoming().uid == request.auth.uid;
      allow read, delete: if isAdmin();
      allow update: if false;
    }
  }
}
